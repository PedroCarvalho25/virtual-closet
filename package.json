{
  "name": "virtual-closet",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "ios": "expo start --go --ios",
    "android": "expo start --go --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests scripts eslint.config.js metro.config.js babel.config.js tailwind.config.js playwright.config.ts vitest.config.mjs",
    "test": "vitest run",
    "test:ui": "node scripts/export-ui-test.mjs && node scripts/test-ui.mjs",
    "test:ui:run": "node scripts/test-ui.mjs",
    "format": "prettier --write app src tests scripts README.md CONTINUITY.md docs/*.md",
    "check": "npm run typecheck && npm run lint && npm test",
    "doctor": "expo-doctor",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:web": "expo export --platform web",
    "preview": "node scripts/design-preview.mjs",
    "preview:build": "node scripts/export-ui-test.mjs",
    "iphone:qr": "node scripts/iphone-page.mjs",
    "preview:open": "node scripts/open-preview.mjs",
    "build:local": "node scripts/build-web.mjs real",
    "app:local": "node scripts/open-build.mjs real",
    "build:preview": "node scripts/build-web.mjs preview",
    "preview:current": "node scripts/open-build.mjs preview"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.2",
    "nativewind": "^4.2.7",
    "onnxruntime-web": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "decode-uri-component": "^0.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "expo-doctor": "^1.20.4",
    "prettier": "^3.9.9",
    "toqr": "^0.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
